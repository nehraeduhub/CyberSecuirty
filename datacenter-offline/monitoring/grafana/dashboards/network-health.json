    {
      "type": "stat",
      "title": "Hardware alerts",
      "description": "Devices reporting a degraded or failed component: power supply, temperature, disks, controller, HA.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "A",
          "expr": "count((max by (instance, name, vendor, glpi_url) (clamp_min(max by (instance, name, vendor, glpi_url) ({__name__=~\"cpqHeTemperatureCondition|cpqHeFltTolPowerSupplyCondition|cpqHeFltTolPwrSupplyCondition|cpqDaPhyDrvCondition|cpqDaLogDrvCondition|cpqDaCntlrCondition\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"}) - 1, 0) or clamp(max by (instance, name, vendor, glpi_url) ({__name__=~\"globalSystemStatus|globalStorageStatus\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"}) - 2, 0, 3) or max by (instance, name, vendor, glpi_url) ((dellNetPowerSupplyOperStatus{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} == bool 2) * 2 + 1) or max by (instance, name, vendor, glpi_url) (sfosDeviceCurrentHAState{sfosDeviceCurrentHAState=\"faulty\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} * 2 + 1) or max by (instance, name, vendor, glpi_url) (up{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"}) * 0)) >= 2) or vector(0)",
          "legendFormat": "",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false
      },
      "id": 4,
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dc-prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Restarted in last 24 h",
