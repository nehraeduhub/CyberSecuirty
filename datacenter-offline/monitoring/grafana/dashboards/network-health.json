      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "glpi_url": true,
              "instance": false,
              "vendor": true
            },
            "renameByName": {
              "name": "Name",
              "instance": "Address",
              "Value #A": "Memory",
              "Value #B": "Disk",
              "Value #C": "Swap",
              "Value #D": "Live users",
              "Value #E": "HA state"
            },
            "indexByName": {
              "name": 0,
              "instance": 1,
              "Value #E": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "–"
