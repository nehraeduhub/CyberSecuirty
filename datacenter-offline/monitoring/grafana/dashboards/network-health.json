    {
      "type": "table",
      "title": "Devices",
      "description": "SNMP status, hardware health, uptime and port counts per device. Click a name to edit it in the DC NOC.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "A",
          "expr": "max by (instance, name, vendor, glpi_url) (up{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "B",
          "expr": "max by (instance, name, vendor, glpi_url) (clamp_min(max by (instance, name, vendor, glpi_url) ({__name__=~\"cpqHeTemperatureCondition|cpqHeFltTolPowerSupplyCondition|cpqHeFltTolPwrSupplyCondition|cpqDaPhyDrvCondition|cpqDaLogDrvCondition|cpqDaCntlrCondition\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"}) - 1, 0) or clamp(max by (instance, name, vendor, glpi_url) ({__name__=~\"globalSystemStatus|globalStorageStatus\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"}) - 2, 0, 3) or max by (instance, name, vendor, glpi_url) ((dellNetPowerSupplyOperStatus{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} == bool 2) * 2 + 1) or max by (instance, name, vendor, glpi_url) (sfosDeviceCurrentHAState{sfosDeviceCurrentHAState=\"faulty\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} * 2 + 1) or max by (instance, name, vendor, glpi_url) (up{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"}) * 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "C",
          "expr": "max by (instance, name, vendor, glpi_url) (sysUpTime{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"}) / 100",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "D",
          "expr": "count by (instance, name, vendor, glpi_url) (ifOperStatus{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "E",
          "expr": "count by (instance, name, vendor, glpi_url) ((ifOperStatus{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} == 2) and on(instance, ifIndex) (ifAdminStatus{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} == 1))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "glpi_url": true,
              "instance": false
            },
            "renameByName": {
              "name": "Name",
              "vendor": "Vendor",
              "instance": "Address",
              "Value #A": "SNMP",
              "Value #B": "Health",
              "Value #C": "Uptime",
              "Value #D": "Ports up",
              "Value #E": "Ports down"
            },
            "indexByName": {
              "name": 0,
              "vendor": 1,
              "instance": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Health",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "noValue": "–"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SNMP"
            },
            "properties": [
