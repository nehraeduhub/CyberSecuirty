          "refId": "A",
          "expr": "label_replace(cpqHeFltTolPowerSupplyCondition{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} > 2, \"component\", \"Power supply bay $1\", \"cpqHeFltTolPowerSupplyBay\", \"(.*)\") or label_replace(cpqHeTemperatureCondition{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} > 2, \"component\", \"Temperature sensor $1\", \"cpqHeTemperatureIndex\", \"(.*)\") or label_replace(cpqDaPhyDrvCondition{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} > 2, \"component\", \"Physical drive $1\", \"cpqDaPhyDrvIndex\", \"(.*)\")",
          "legendFormat": "",
