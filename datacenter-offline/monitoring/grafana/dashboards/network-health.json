          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "auth": true,
              "module": true,
              "itemtype": true,
              "glpi_id": true,
              "glpi_url": true,
              "status": true,
              "rack": true,
              "type": true,
              "vendor": true,
              "cpqHeFltTolPowerSupplyBay": true,
              "cpqHeFltTolPowerSupplyChassis": true,
              "cpqHeTemperatureIndex": true,
              "cpqHeTemperatureChassis": true,
              "cpqDaPhyDrvIndex": true,
