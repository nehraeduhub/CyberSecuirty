    {
      "type": "table",
      "title": "Ports down",
      "description": "Enabled ports with no link, and how long since the link went down (from the device's own counters).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "A",
          "expr": "max by (instance, name, vendor, glpi_url, ifName) ((ifOperStatus{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} == 2) and on(instance, ifIndex) (ifAdminStatus{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} == 1))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "B",
          "expr": "max by (instance, name, vendor, glpi_url, ifName) (((ifLastChange{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} * 0 + on(instance) group_left() max by (instance) (sysUpTime{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"})) - ifLastChange{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"}) / 100 and on(instance, ifIndex) ((ifOperStatus{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} == 2) and on(instance, ifIndex) (ifAdminStatus{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} == 1)))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "glpi_url": true,
              "instance": true,
              "Value #A": true,
              "vendor": true
            },
            "renameByName": {
              "name": "Name",
              "vendor": "Vendor",
              "instance": "Address",
              "ifName": "Port",
              "Value #B": "Down for"
            },
            "indexByName": {
              "name": 0,
              "ifName": 1,
              "vendor": 2,
              "instance": 3,
              "Value #B": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "–"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Down for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Edit in DC NOC",
                    "url": "${__data.fields.glpi_url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dc-prometheus"
      }
    },
    {
      "type": "table",
      "title": "Port errors, last hour",
      "description": "Ports that counted input or output errors in the last hour: usually a bad cable, optic or duplex mismatch.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "A",
          "expr": "sum by (instance, name, vendor, glpi_url, ifName) (increase(ifInErrors{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"}[1h]) + increase(ifOutErrors{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"}[1h])) > 0",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "glpi_url": true,
              "instance": true,
              "vendor": true
            },
            "renameByName": {
              "name": "Name",
              "vendor": "Vendor",
              "instance": "Address",
              "ifName": "Port",
              "Value": "Errors"
            },
            "indexByName": {
              "name": 0,
              "ifName": 1,
              "vendor": 2,
              "instance": 3,
              "Value": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "decimals": 0,
          "noValue": "–"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Edit in DC NOC",
                    "url": "${__data.fields.glpi_url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
