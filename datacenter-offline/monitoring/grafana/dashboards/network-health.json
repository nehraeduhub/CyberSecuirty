    {
      "type": "stat",
      "title": "Ports down",
      "description": "Ports that are enabled but have no link. Spare ports that are shut down are not counted.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "A",
          "expr": "count((ifOperStatus{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} == 2) and on(instance, ifIndex) (ifAdminStatus{job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} == 1)) or vector(0)",
          "legendFormat": "",
          "range": true,
          "format": "time_series"
