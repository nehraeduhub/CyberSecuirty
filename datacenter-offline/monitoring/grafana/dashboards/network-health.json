          "refId": "E",
          "expr": "max by (instance, name, vendor, glpi_url) (sfosDeviceCurrentHAState{sfosDeviceCurrentHAState=\"notapplicable\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} * 0 or sfosDeviceCurrentHAState{sfosDeviceCurrentHAState=\"auxiliary\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} * 1 or sfosDeviceCurrentHAState{sfosDeviceCurrentHAState=\"standAlone\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} * 2 or sfosDeviceCurrentHAState{sfosDeviceCurrentHAState=\"primary\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} * 3 or sfosDeviceCurrentHAState{sfosDeviceCurrentHAState=\"faulty\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} * 4 or sfosDeviceCurrentHAState{sfosDeviceCurrentHAState=\"ready\", job=\"snmp\", vendor=~\"$vendor\", name=~\"$device\"} * 5)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
