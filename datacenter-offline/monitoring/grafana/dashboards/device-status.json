{
  "uid": "dc-device-status",
  "title": "Device status",
  "tags": [
    "data centre",
    "glpi"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "type",
        "label": "Category",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dc-prometheus"
        },
        "query": {
          "query": "label_values(probe_success{job=\"device\"}, type)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(probe_success{job=\"device\"}, type)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "rack",
        "label": "Location",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dc-prometheus"
        },
        "query": {
          "query": "label_values(probe_success{job=\"device\", type=~\"$type\"}, rack)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(probe_success{job=\"device\", type=~\"$type\"}, rack)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "data centre"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Dashboards"
    }
  ],
