        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "A",
          "expr": "quantile(0.5, probe_icmp_duration_seconds{phase=\"rtt\", job=\"device\", type=~\"$type\", rack=~\"$rack\"} and on(instance) (probe_success{job=\"device\", type=~\"$type\", rack=~\"$rack\"} == 1))",
          "legendFormat": "",
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
