        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "A",
          "expr": "max by (instance, name, type, rack, glpi_url) (probe_success{job=\"device\", type=~\"$type\", rack=~\"$rack\"}) == 0",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dc-prometheus"
          },
          "refId": "B",
          "expr": "max by (instance, name, type, rack, glpi_url) (time() - max_over_time(timestamp(probe_success{job=\"device\", type=~\"$type\", rack=~\"$rack\"} == 1)[7d:1m])) and on(instance) (probe_success{job=\"device\", type=~\"$type\", rack=~\"$rack\"} == 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "itemtype": true,
              "glpi_id": true,
              "phase": true,
              "module": true,
              "status": true,
              "glpi_url": true,
              "Value #A": true
            },
            "renameByName": {
              "name": "Name",
              "type": "Category",
              "rack": "Location",
              "instance": "Address",
              "Value #B": "Down for"
            },
            "indexByName": {
              "name": 0,
              "type": 1,
              "rack": 2,
              "instance": 3,
              "Value #B": 4
            }
          }
        }
      ],
