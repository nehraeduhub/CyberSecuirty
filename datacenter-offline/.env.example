# Copy to .env (install-offline.sh does this and generates a random DB password).

# Versions - must match the images saved in the offline bundle
GLPI_VERSION=11.0.11
MARIADB_VERSION=11.4
NGINX_VERSION=1.27-alpine
# GLPI Agent used by the network collector image
AGENT_VERSION=1.17
# Monitoring
GRAFANA_VERSION=13.0.2
PROMETHEUS_VERSION=v3.5.5
BLACKBOX_VERSION=v0.28.0

# Host ports
GLPI_PORT=80
PORTAL_PORT=8080

# Database (used by both GLPI and MariaDB)
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=change-me

# Extra IPv4 range allowed to use the GLPI REST API (e.g. your admin LAN).
# The Docker network and this host are always allowed. Leave empty to skip.
API_ADMIN_RANGE_START=
API_ADMIN_RANGE_END=

# ---------------------------------------------------------- Monitoring
# Set by install-offline.sh (random passwords, this server's address)
GRAFANA_ADMIN_PASSWORD=
MONITOR_GLPI_PASSWORD=
GLPI_PUBLIC_URL=
GRAFANA_ROOT_URL=
# true = anyone who can open the portal sees dashboards without logging in (wall screens)
GRAFANA_ANONYMOUS=false
# Minutes between GLPI -> monitoring target syncs, and how long to keep history
MONITOR_SYNC_MINUTES=5
PROMETHEUS_RETENTION=90d
# GLPI statuses not to monitor, comma separated (e.g. Retired,In stock)
MONITOR_EXCLUDE_STATES=
