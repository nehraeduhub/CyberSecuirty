# Copy to .env (install-offline.sh does this and fills in the rest).

# Versions - must match the images saved in the offline bundle
NGINX_VERSION=1.27-alpine
# GLPI Agent tools used by the network scanner (collector) image
AGENT_VERSION=1.17
# Monitoring
GRAFANA_VERSION=13.0.2
PROMETHEUS_VERSION=v3.5.5
BLACKBOX_VERSION=v0.28.0
SNMP_EXPORTER_VERSION=v0.30.1

# HTTPS (recommended):
#   yes -> https://<server>[:HTTPS_PORT]/ opens the DC NOC Monitor;
#          https://<server>:PORTAL_TLS_PORT/ = website, library, DC Viewer, Grafana
#          (certificate in tls/server.crt + tls/server.key; self-signed one generated if missing)
#   no  -> plain HTTP on PORTAL_PORT
TLS=yes
# Name users type in the browser (DNS name); empty = this server's IP address
SERVER_NAME=
# HTTPS ports on the host. If another web server already uses 80/443 on this
# machine, pick free ones, e.g. HTTPS_PORT=9443 and HTTP_REDIRECT_PORT=8880
HTTPS_PORT=443
HTTP_REDIRECT_PORT=80
PORTAL_TLS_PORT=8443

# Host port in HTTP mode
PORTAL_PORT=8080

# ---------------------------------------------------------- Monitoring
# Set by install-offline.sh (random password, this server's address)
GRAFANA_ADMIN_PASSWORD=
PUBLIC_URL=
GRAFANA_ROOT_URL=
# true = dashboards open without logging in (as the rest of the DC NOC)
GRAFANA_ANONYMOUS=true
# Minutes between device list -> monitoring target syncs (changes made in the
# DC Viewer apply at once), and how long to keep history
MONITOR_SYNC_MINUTES=5
PROMETHEUS_RETENTION=90d
