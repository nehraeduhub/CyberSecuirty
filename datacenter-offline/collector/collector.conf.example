# Network collector settings. Copy to collector.conf (chmod 600: it holds credentials).
# Lines starting with # are ignored in every list.

# How often to collect, in minutes
INTERVAL_MINUTES=60

# Parallel threads for SNMP scans
THREADS=16

# Seconds to wait for an SNMP answer from each address (the agent's own
# default is 60, which makes a /24 with few devices take hours)
SNMP_TIMEOUT=2

# ---------------------------------------------------------------- SNMP
# IP ranges to discover: Cisco/Dell/HP switches and routers, Sophos firewall,
# Radware Alteon, iLO and iDRAC cards, PDUs, UPS. One range per line:
# first-last or a single IP. Nothing is scanned until you add a range here.
# See EQUIPMENT.md for what to enable on each device.
SNMP_RANGES="
# 10.10.0.1-10.10.0.254      # network management (switches, routers, Sophos, Alteon)
# 10.10.9.1-10.10.9.254      # out-of-band (iLO, iDRAC)
"

# Read-only SNMP credentials, tried in order (put the most common first). One
# per line. Also used by the monitoring to poll ports and hardware health.
SNMP_CREDENTIALS="
# version:2c,community:CHANGE-ME
# version:3,username:glpi,authprotocol:sha,authpassword:CHANGE,privprotocol:aes,privpassword:CHANGE
"

# ------------------------------------------------- Agentless servers
# Linux/Unix over SSH (key in collector/ssh/id_ed25519, see README) and
# Windows over WinRM (enable with: winrm quickconfig). One URL per line.
REMOTES="
# ssh://inventory@10.10.3.21        # HPE VM Essentials host
# ssh://inventory@10.10.1.21
# ssh://inventory@10.10.1.22
# winrm://inventory:CHANGE@10.10.1.40
"

# ------------------------------------------------------------- VMware
# ESXi hosts or vCenter: host user password (one per line, read-only role).
# For HPE SimpliVity, list the vCenter that manages the federation.
ESX_HOSTS="
# 10.10.2.10 svc-glpi@vsphere.local CHANGE
"
