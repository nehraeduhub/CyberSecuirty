# Rendered by the official nginx image at start-up (envsubst of ${PORTAL_HOSTNAME}, ${MESH_HOSTNAME} and ${HTTPS_PORT}).
# NGINX listens on HTTPS_PORT inside the container too, so the public URLs (with port) work from inside the stack.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# Resolve container names at request time (Docker DNS), so a restarted container with a new IP is found again.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

# Any other host name or the bare IP address (e.g. https://10.20.30.40:7443): send the browser to the portal
# name. The portal and the console only work under their DNS names (certificate, cookies, Django host check).
server {
    listen ${HTTPS_PORT} ssl default_server;
    server_name _;
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    return 301 https://${PORTAL_HOSTNAME}:${HTTPS_PORT}$request_uri;
}

# ---------------------------------------------------------------- portal
server {
    listen ${HTTPS_PORT} ssl;
    server_name ${PORTAL_HOSTNAME};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    # Everything is served locally: no CDN, no external fonts or scripts.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src https://${MESH_HOSTNAME}:${HTTPS_PORT}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    client_max_body_size 10m;

    location /api/ {
        set $web_upstream http://web:8000;
        proxy_pass $web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }
    location /static/ { alias /static/; access_log off; }
    location / {
        set $frontend_upstream http://frontend:80;
        proxy_pass $frontend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# ---------------------------------------------------- MeshCentral engine
# Browsers (remote console, chat), agents (agent.ashx / meshrelay.ashx) and agent downloads.
server {
    listen ${HTTPS_PORT} ssl;
    server_name ${MESH_HOSTNAME};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    # The console may only be framed by the portal.
    add_header Content-Security-Policy "frame-ancestors https://${PORTAL_HOSTNAME}:${HTTPS_PORT}" always;
    client_max_body_size 1g;

    location / {
        set $mesh_upstream http://meshcentral:4430;
        proxy_pass $mesh_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_send_timeout 330s;
        proxy_read_timeout 330s;
    }
}
