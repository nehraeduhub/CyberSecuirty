# COPY TO .env AND REPLACE EVERY CHANGE-ME VALUE (deploy/generate-secrets.sh prints random values).
# Internal DNS names (both must be in the TLS certificate in deploy/certs/).
PORTAL_HOSTNAME=remote.techguardinas.local
MESH_HOSTNAME=mesh.remote.techguardinas.local

DJANGO_SECRET_KEY=CHANGE-ME
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=remote.techguardinas.local
CSRF_TRUSTED_ORIGINS=https://remote.techguardinas.local
PORTAL_PUBLIC_URL=https://remote.techguardinas.local
MESH_PUBLIC_URL=https://mesh.remote.techguardinas.local

POSTGRES_DB=techguardinas_remote
POSTGRES_USER=techguardinas_remote
POSTGRES_PASSWORD=CHANGE-ME

BOOTSTRAP_ADMIN_ON_START=true
BOOTSTRAP_ADMIN_USERNAME=tgadmin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME
BOOTSTRAP_ADMIN_RESET=false

# --- Remote-support policy
ATTENDED_CODE_TTL_MINUTES=10
SESSION_MAX_MINUTES=120
ATTENDED_OFFLINE_GRACE_SECONDS=45
# desktop is always on; remote user still approves each on screen
ATTENDED_CAPABILITIES=desktop,chat,files,terminal
UNATTENDED_REQUIRE_MFA=true
ATTENDED_REQUIRE_MFA=false
MESH_SESSION_RECORDING=false
# MeshCentral consent flags: 1/2/4 notify desktop/terminal/files, 8/16/32 prompt, 64 connection bar
MESH_CONSENT_ATTENDED=127
MESH_CONSENT_UNATTENDED=71
# Clipboard policy (applies to all sessions; MeshCentral has no per-user clipboard setting)
MESH_CLIPBOARD_GET=true
MESH_CLIPBOARD_SET=true
MESH_IDLE_TIMEOUT_MINUTES=15

PORTAL_MFA_ISSUER="TechGuardinas Remote"
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
