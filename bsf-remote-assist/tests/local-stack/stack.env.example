# Local acceptance stack (Linux test endpoints). Copy to stack.env and adjust paths.
WORK=${WORK:-/srv/bsf-stack}                    # scratch directory (databases, logs, agents, evidence)
REPO=/home/user/CyberSecuirty/bsf-remote-assist
VENV=/root/venv                          # python venv with backend requirements + tests/e2e/requirements.txt
MESH_NODE_MODULES=/root/mc/node_modules  # `npm install meshcentral@1.2.5` (copied with hard links)
PG_BIN=/usr/lib/postgresql/16/bin
CHROMIUM=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
PKI=/root/pki                            # ca.crt, fullchain.pem, privkey.pem for both host names
PORTAL_HOST=remote.bsf.test
MESH_HOST=mesh.remote.bsf.test
ADMIN_PASSWORD=Admin-Test-Passw0rd!
