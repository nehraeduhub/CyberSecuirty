# LOCAL AUTHENTICATION IS THE DEFAULT. AD/LDAP IS OPTIONAL AND CAN BE CONFIGURED FROM Settings after first login.
# COPY TO .env AND REPLACE EVERY CHANGE-ME VALUE.
DJANGO_SECRET_KEY=GENERATE-A-64-CHARACTER-RANDOM-SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=remote.inet.gov.in
CSRF_TRUSTED_ORIGINS=https://remote.inet.gov.in
POSTGRES_DB=bsf_remote
POSTGRES_USER=bsf_remote
POSTGRES_PASSWORD=CHANGE-ME-LONG-RANDOM-PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=
LDAP_GROUP_BASE_DN=
LDAP_REQUIRE_GROUP=
LDAP_START_TLS=False
PORTAL_MFA_ISSUER=BSF Remote
MESH_BASE_URL=https://mesh.remote.inet.gov.in
MESH_HOSTNAME=mesh.remote.inet.gov.in
MESH_ALLOWED_ORIGIN=https://remote.inet.gov.in
MESHCENTRAL_IMAGE=ghcr.io/ylianst/meshcentral:1.2.6
MESH_API_KEY=CHANGE-ME
MESH_ADMIN_USER=CHANGE-ME
MESH_ADMIN_PASSWORD=CHANGE-ME
MESHCTRL_PATH=/opt/meshcentral/meshcentral/node_modules/meshcentral/meshctrl.js
MESH_LOGIN_KEY_FILE=/run/secrets/mesh_login_key
MESH_SSO_ENABLED=False
MESH_ACTION_TIMEOUT=60
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

BOOTSTRAP_ADMIN_ON_START=true
BOOTSTRAP_ADMIN_USERNAME=bsfadmin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-USE-A-LONG-RANDOM-PASSWORD
BOOTSTRAP_ADMIN_RESET=false
