<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Stage 7 MSI source skeleton. Build/sign on a controlled Windows CI host.
       Do not embed enrollment tokens in this MSI. -->
  <Product Id="*" Name="BSF Remote Management Agent" Language="1033" Version="0.7.0.0" Manufacturer="BSF Remote" UpgradeCode="PUT-STABLE-UPGRADE-GUID-HERE">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MediaTemplate EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="BSF Remote" />
      </Directory>
    </Directory>
    <Feature Id="MainFeature" Level="1">
      <ComponentGroupRef Id="MainFiles" />
    </Feature>
    <Fragment>
      <ComponentGroup Id="MainFiles" Directory="INSTALLFOLDER">
        <Component Id="AgentFiles" Guid="*">
          <File Source="bsf_remote_agent.py" />
          <File Source="install-agent.ps1" />
        </Component>
      </ComponentGroup>
    </Fragment>
  </Product>
</Wix>
